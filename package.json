{
  "name": "local-helper-ai",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "preview": "vite preview",
    "tauri": "GDK_BACKEND=x11 tauri",
    "build:app": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --no-bundle",
    "build:deb": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --bundles deb && mkdir -p releases && cp \"src-tauri/target/release/bundle/deb/Local Helper Mascot_0.7.5_amd64.deb\" releases/local-helper-ai_0.7.5_amd64.deb",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml && rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@tauri-apps/api": "^2.2.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tunnelmole": "^2.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
